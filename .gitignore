*.log

# synthetic-data runtime artifacts (regenerate with make synth)
data/synthetic/*.rejected.json

# regenerable training mixture (~20 MB; `make mixture` rebuilds it byte-identically)
data/synthetic/train_mixture*.jsonl

# Local agent scratch (subagent run artifacts)
.pi-subagents/

# Verification run logs (reconstruct via scripts/finalize_partial_verify.py if lost)
m2c_*.log
